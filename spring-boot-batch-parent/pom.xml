            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Alex Mondshain</name>
            <email>alex.mondshain@gmail.com</email>
        </developer>
    </developers>

    <modules>
        <module>spring-boot-batch-restart</module>
        <module>spring-boot-batch-flow</module>
        <module>spring-boot-batch-tasklet</module>
        <module>spring-boot-batch-partition</module>
    </modules>
</project>
